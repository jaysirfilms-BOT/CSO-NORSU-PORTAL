# No file listing if a folder has no index page.
Options -Indexes

# Source, docs, backups and hidden files are never served.
<FilesMatch "(^\.|\.(sql|md|log|ini|sh|bak|old|orig|swp|zip|gz|tar|env|lock|json)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Never serve the git folder (its files do not start with a dot, so the rule above misses them).
RedirectMatch 404 /\.git

# The mail test page must never be reachable from the web. Delete the file too.
<Files "test_mail.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
